//@version=6
// SmartVibe adaptation of the Strong GEX Liquidations concept.
// The positioning/size input is a MARKET PROXY when open interest is unavailable.
// It is evidence only and must not override SmartVibe Primary Methodology.
indicator("SMARTVIBE LIQUIDATION SYSTEM", shorttitle="SV Liquidation", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=100, max_bars_back=2000)

lookback = input.int(120, "Positioning Lookback", minval=20, maxval=1000)
useRangeProxy = input.bool(true, "Use Volume × Range proxy")
volumeLen = input.int(30, "Volume Baseline", minval=5)
spike = input.float(2.0, "Trigger Spike", minval=1.0, step=0.1)
atrLen = input.int(14, "ATR Length", minval=2)
rangePadding = input.float(0.35, "Range Padding ATR", minval=0.05, step=0.05)
beamCount = input.int(12, "Maximum Liquidation Beams", minval=1, maxval=40)
minStrength = input.float(1.5, "Minimum Strength", minval=0.1, step=0.1)
showLabels = input.bool(true, "Show Strength Labels")
extendBars = input.int(40, "Beam Extension", minval=5, maxval=200)
fadeConsumed = input.bool(true, "Fade Consumed Levels")

atr = ta.atr(atrLen)
baseVol = ta.sma(volume, volumeLen)
volRatio = baseVol > 0 ? volume / baseVol : 0.0
barRange = high - low
rangeRatio = atr > 0 ? barRange / atr : 0.0
proxySize = useRangeProxy ? volume * barRange : volume
proxyBase = ta.sma(proxySize, lookback)
sizeRatio = proxyBase > 0 ? proxySize / proxyBase : 0.0
trigger = volRatio >= spike or sizeRatio >= spike

// Leverage tiers are projections, not exchange-confirmed GEX/OI levels.
var float[] levels = array.new_float()
var float[] strengths = array.new_float()
var int[] sides = array.new_int()
var int[] born = array.new_int()

f_add_level(float price, float strength, int side) =>
    if strength >= minStrength
        bool merged = false
        int n = array.size(levels)
        if n > 0
            for i = 0 to n - 1
                if math.abs(array.get(levels, i) - price) <= atr * rangePadding
                    if strength > array.get(strengths, i)
                        array.set(levels, i, price)
                        array.set(strengths, i, strength)
                        array.set(sides, i, side)
                    merged := true
                    break
        if not merged
            array.push(levels, price)
            array.push(strengths, strength)
            array.push(sides, side)
            array.push(born, bar_index)

if trigger and atr > 0
    float baseStrength = math.max(volRatio, sizeRatio)
    // A long liquidation projection sits below price; a short liquidation projection sits above.
    f_add_level(close - atr * 0.5, baseStrength * 1.0, -1)
    f_add_level(close - atr * 1.0, baseStrength * 1.15, -1)
    f_add_level(close - atr * 2.0, baseStrength * 1.35, -1)
    f_add_level(close + atr * 0.5, baseStrength * 1.0, 1)
    f_add_level(close + atr * 1.0, baseStrength * 1.15, 1)
    f_add_level(close + atr * 2.0, baseStrength * 1.35, 1)

while array.size(levels) > beamCount
    array.shift(levels), array.shift(strengths), array.shift(sides), array.shift(born)

var line[] beams = array.new_line()
var label[] tags = array.new_label()
if barstate.islast
    if array.size(beams) > 0
        for i = 0 to array.size(beams) - 1
            line.delete(array.get(beams, i))
    if array.size(tags) > 0
        for i = 0 to array.size(tags) - 1
            label.delete(array.get(tags, i))
    array.clear(beams)
    array.clear(tags)
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            lvl = array.get(levels, i)
            str = array.get(strengths, i)
            side = array.get(sides, i)
            consumed = side < 0 ? close < lvl : close > lvl
            width = str >= 4 ? 4 : str >= 2.5 ? 3 : 2
            ln = line.new(bar_index, lvl, bar_index + extendBars, lvl, width=width, style=line.style_solid, color=consumed and fadeConsumed ? color.new(color.gray, 75) : side > 0 ? color.new(color.red, 15) : color.new(color.lime, 15))
            array.push(beams, ln)
            if showLabels
                txt = side > 0 ? "SHORT LIQ • " : "LONG LIQ • "
                lb = label.new(bar_index + 1, lvl, txt + str.tostring(str, "#.##"), style=label.style_label_left, textcolor=color.white, color=side > 0 ? color.new(color.red, 25) : color.new(color.green, 25), size=size.tiny)
                array.push(tags, lb)

nearestAbove = ta.valuewhen(high > close, high, 0)
nearestBelow = ta.valuewhen(low < close, low, 0)
proximity = atr > 0 and (math.abs(close - nearestAbove) < atr * 0.25 or math.abs(close - nearestBelow) < atr * 0.25)
alertcondition(trigger, "Liquidation trigger", "SMARTVIBE Liquidation System detected a positioning/volume proxy trigger")
alertcondition(proximity, "Liquidation proximity", "SMARTVIBE Liquidation System detected proximity to a projected liquidation level")
